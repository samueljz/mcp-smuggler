# =============================================================================
# MCP Atlassian — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# Generate API tokens at:
# https://id.atlassian.com/manage-profile/security/api-tokens
# =============================================================================

# --- Jira -------------------------------------------------------------------
# Base URL of your Jira instance (no trailing slash)
JIRA_URL=https://your-company.atlassian.net

# Atlassian account email used for Jira
JIRA_USERNAME=your.email@company.com

# Jira personal API token
JIRA_API_TOKEN=your_jira_api_token

# --- Confluence -------------------------------------------------------------
# Base URL of your Confluence instance (includes /wiki path for Cloud)
CONFLUENCE_URL=https://your-company.atlassian.net/wiki

# Atlassian account email used for Confluence
CONFLUENCE_USERNAME=your.email@company.com

# Confluence personal API token
CONFLUENCE_API_TOKEN=your_confluence_api_token

# =============================================================================
# Notes:
#  - You can omit Confluence variables if you only need Jira, and vice versa.
#  - The MCP server will only enable the tools whose variables are present.
#  - See: https://mcp-atlassian.soomiles.com/docs/configuration
# =============================================================================


# =============================================================================
# Figma MCP Server — Environment Variables
# =============================================================================
# Required to use the Figma MCP server via mcp-cli.
# The Figma server runs via `npx figma-developer-mcp` and authenticates using
# a Personal Access Token (PAT) — no browser login required.
#
# Generate your token at:
#   https://www.figma.com/settings  →  Security  →  Personal access tokens
# Required scope: read access to files and nodes
# =============================================================================

# --- Figma ------------------------------------------------------------------
# Figma Personal Access Token (PAT) for design data access
# Tokens typically start with "figd_"
FIGMA_API_KEY=your_figma_personal_access_token

# Directory where downloaded Figma images are saved (defaults to ./images)
IMAGE_DIR=./images

# Optional: Disable Figma MCP telemetry (already set to DO_NOT_TRACK=1 in mcp_servers.json)
# DO_NOT_TRACK=1
# FRAMELINK_TELEMETRY=off


